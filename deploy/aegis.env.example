AEGIS_STORAGE=/var/lib/aegis
AEGIS_WORKERS=2
AEGIS_MAX_FILE_MIB=100
AEGIS_JOB_TIMEOUT=300
AEGIS_RESEARCH_TIMEOUT=180
AEGIS_COOKIE_SECURE=1
AEGIS_ALLOWED_HOSTS=research.example.com,localhost,127.0.0.1
AEGIS_PUBLIC_ORIGIN=https://research.example.com
AEGIS_EMBEDDING_MODEL=/opt/aegis/data/models/bge-small-en-v1.5
AEGIS_MODEL_URL=http://127.0.0.1:11435
