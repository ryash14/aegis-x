[Unit]
Description=AEGIS pinned local inference runtime
After=network.target

[Service]
Type=simple
User=aegis-model
Group=aegis-model
WorkingDirectory=/opt/aegis
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=/opt/aegis/data/models/ollama
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_CONTEXT_LENGTH=8192
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_FLASH_ATTENTION=1
ExecStart=/opt/aegis/data/runtime/ollama/bin/ollama serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=aegis-model
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aegis-model
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=10G
TasksMax=256

[Install]
WantedBy=multi-user.target
